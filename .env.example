# ── NosePrints-Pawfriend Environment Configuration ──
# Copy this file to .env and fill in your values.
# Never commit a real .env file.

# ── App ──
APP_NAME=NosePrints-Pawfriend
APP_VERSION=0.1.0
# Set DEBUG=false in any shared/staging/production environment.
DEBUG=true

# ── Database (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+asyncpg://noseprints:noseprints@localhost:5432/noseprints_db
DATABASE_URL_SYNC=postgresql://noseprints:noseprints@localhost:5432/noseprints_db
# Set false only on Windows if antivirus TLS inspection breaks Supabase (self-signed chain).
# DATABASE_SSL_VERIFY=true

# ── S3-compatible Object Storage (durable photos) ──
# Leave blank for local filesystem (dev). On Cloud Run, local uploads vanish on redeploy.
# Cloudflare R2 / B2 / AWS / GCS (S3 API): set all of these for durable photos.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=noseprints-photos
S3_REGION=auto
# Browser-facing base URL (R2 public bucket / custom domain). Required for R2 so <img> works.
# Example: https://pub-xxxxx.r2.dev
# S3_PUBLIC_BASE_URL=

# ── ML Models ──
NOSE_DETECTOR_MODEL_PATH=models/nose_detector.onnx
EMBEDDING_MODEL_PATH=models/embedding_model.onnx
DETECTOR_CONF_THRESHOLD=0.35
DETECTOR_RETRY_CONF_THRESHOLD=0.20
DETECTOR_CLOSEUP_PAD=0.30
# Reject register/identify if final YOLO confidence is below this (G0 garbage gate)
DETECTOR_MIN_ACCEPT_CONF=0.40

# ── Matching (ROC-tuned 17 Aug 2026; do not use 0.85) ──
MATCH_THRESHOLD=0.56
MATCH_THRESHOLD_LOW=0.51
# Public / senior demos: set true to disable "possible" band (only ≥ MATCH_THRESHOLD_STRICT)
MATCH_STRICT_DEMO=false
MATCH_THRESHOLD_STRICT=0.60
# Staff queue: true = only "likely" (matched) rows; also implied when MATCH_STRICT_DEMO=true
MATCH_QUEUE_LIKELY_ONLY=false
LOST_STATUS_BOOST=0.03
TOP_K_MATCHES=5

# ── Image Quality ──
MIN_SHARPNESS_SCORE=70.0
MIN_BRIGHTNESS=40
MAX_BRIGHTNESS=220
MIN_NOSE_COVERAGE=0.15

# ── G1 nose junk filters (aspect / edges / likeness) ──
NOSE_CROP_MIN_ASPECT=0.55
NOSE_CROP_MAX_ASPECT=1.85
NOSE_MAX_EDGE_DENSITY=0.22
NOSE_MAX_GRID_REGULARITY=0.42
NOSE_MIN_LIKENESS=0.32
NOSE_MIN_LAPLACIAN=28.0
NOSE_REDETECT_ON_CROP=true
NOSE_MAX_BBOX_FRAME_FRACTION=0.92
NOSE_MIN_BBOX_IN_CROP=0.12

# ── G3 look-photo soft gate ──
LOOK_MAX_EDGE_DENSITY=0.18
LOOK_MAX_GRID_REGULARITY=0.38
LOOK_MIN_LAPLACIAN=22.0
# Hours after dog creation that public profile-photo overwrite is allowed (staff bypasses)
PROFILE_PHOTO_OPEN_HOURS=48

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://pawfriend.in"]

# ── JWT (staff auth) ──
# DEBUG=true will start with the built-in dev secret if this is unset.
# DEBUG=false WILL REFUSE TO START unless JWT_SECRET_KEY is a unique 32+ character secret.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-for-production-change-me-32b
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Optional: create the first staff admin on startup if the staff table is empty.
# After that, log in via POST /api/v1/auth/login
# STAFF_BOOTSTRAP_EMAIL=staff@pawfriend.in
# STAFF_BOOTSTRAP_PASSWORD=change-this-password

# ── Rate limits (per IP / 60 seconds) ──
RATE_LIMIT_IDENTIFY_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_FOUND_INTAKE_PER_MINUTE=10

# ── Email (optional; sent only after staff confirms a match) ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@pawfriend.in
# SMTP_USE_TLS=true

# ── Consent copy version (DPDP) ──
CONSENT_TEXT_VERSION=v1

# ── PostgreSQL (for Docker Compose only — not read by FastAPI) ──
# These are used by docker-compose.yml. The backend uses DATABASE_URL above.
POSTGRES_USER=noseprints
POSTGRES_PASSWORD=noseprints
POSTGRES_DB=noseprints_db
