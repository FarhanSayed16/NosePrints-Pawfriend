# ── NosePrints-Pawfriend Environment Configuration ──
# Copy this file to .env and fill in your values.
# Never commit a real .env file.

# ── App ──
APP_NAME=NosePrints-Pawfriend
APP_VERSION=0.1.0
# Set DEBUG=false in any shared/staging/production environment.
DEBUG=true

# ── Database (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+asyncpg://noseprints:noseprints@localhost:5432/noseprints_db
DATABASE_URL_SYNC=postgresql://noseprints:noseprints@localhost:5432/noseprints_db

# ── S3-compatible Object Storage ──
# Leave blank for local filesystem storage (dev mode)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=noseprints-photos
S3_REGION=auto

# ── ML Models ──
NOSE_DETECTOR_MODEL_PATH=models/nose_detector.onnx
EMBEDDING_MODEL_PATH=models/embedding_model.onnx
DETECTOR_CONF_THRESHOLD=0.35
DETECTOR_RETRY_CONF_THRESHOLD=0.20
DETECTOR_CLOSEUP_PAD=0.30

# ── Matching ──
# 0.85 is a placeholder until ROC evaluation in Phase 2.
MATCH_THRESHOLD=0.85
TOP_K_MATCHES=5

# ── Image Quality ──
MIN_SHARPNESS_SCORE=100.0
MIN_BRIGHTNESS=40
MAX_BRIGHTNESS=220
MIN_NOSE_COVERAGE=0.15

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://pawfriend.in"]

# ── JWT (staff auth) ──
# DEBUG=true will start with the built-in dev secret if this is unset.
# DEBUG=false WILL REFUSE TO START unless JWT_SECRET_KEY is a unique 32+ character secret.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-for-production-change-me-32b
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Optional: create the first staff admin on startup if the staff table is empty.
# After that, log in via POST /api/v1/auth/login
# STAFF_BOOTSTRAP_EMAIL=staff@pawfriend.in
# STAFF_BOOTSTRAP_PASSWORD=change-this-password

# ── Consent copy version (DPDP) ──
CONSENT_TEXT_VERSION=v1

# ── PostgreSQL (for Docker Compose) ──
POSTGRES_USER=noseprints
POSTGRES_PASSWORD=noseprints
POSTGRES_DB=noseprints_db
