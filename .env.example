# ── NosePrints-Pawfriend Environment Configuration ──
# Copy this file to .env and fill in your values

# ── App ──
APP_NAME=NosePrints-Pawfriend
APP_VERSION=0.1.0
DEBUG=true

# ── Database (PostgreSQL + pgvector) ──
DATABASE_URL=postgresql+asyncpg://noseprints:noseprints@localhost:5432/noseprints_db
DATABASE_URL_SYNC=postgresql://noseprints:noseprints@localhost:5432/noseprints_db

# ── S3-compatible Object Storage ──
# Leave blank for local filesystem storage (dev mode)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=noseprints-photos
S3_REGION=auto

# ── ML Models ──
NOSE_DETECTOR_MODEL_PATH=models/nose_detector.onnx
EMBEDDING_MODEL_PATH=models/embedding_model.onnx
EMBEDDING_DIMENSION=512

# ── Matching ──
MATCH_THRESHOLD=0.85
TOP_K_MATCHES=5

# ── Image Quality ──
MIN_SHARPNESS_SCORE=100.0
MIN_BRIGHTNESS=40
MAX_BRIGHTNESS=220
MIN_NOSE_COVERAGE=0.15

# ── CORS ──
# Comma-separated origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://pawfriend.in"]

# ── JWT ──
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── PostgreSQL (for Docker Compose) ──
POSTGRES_USER=noseprints
POSTGRES_PASSWORD=noseprints
POSTGRES_DB=noseprints_db
