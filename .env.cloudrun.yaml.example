# Copy to .env.cloudrun.yaml (DO NOT COMMIT) and fill secrets for:
#   .\scripts\cloud_run_deploy.ps1
#
# Cloud Run --env-vars-file format: KEY: "value"

DATABASE_URL: "postgresql+asyncpg://USER:PASS@HOST:5432/postgres"
JWT_SECRET_KEY: "replace-with-32plus-char-secret"
DEBUG: "false"
SERVE_FRONTEND: "true"
FRONTEND_DIR: "/app/frontend_dist"
PUBLIC_APP_URL: "https://YOUR-SERVICE.run.app"
MATCH_STRICT_DEMO: "true"
S3_ENDPOINT_URL: "https://YOUR_ACCOUNT.r2.cloudflarestorage.com"
S3_ACCESS_KEY: "replace"
S3_SECRET_KEY: "replace"
S3_BUCKET_NAME: "noseprints-photos"
S3_REGION: "auto"
S3_PUBLIC_BASE_URL: "https://photos.example.com"
# SMTP_HOST: "smtp.example.com"
# SMTP_PORT: "587"
# SMTP_USER: ""
# SMTP_PASSWORD: ""
# SMTP_FROM: "noreply@pawfriend.in"
